{
  "expo": {
    "name": "Kaden",
    "slug": "kaden",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "kaden",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.dalibor.kaden",
      "supportsTablet": false
    },
    "android": {
      "package": "com.dalibor.kaden"
    },
    "plugins": [
      "expo-dev-client",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Kaden čita tvoja trčanja i puls iz Apple Health radi analize treninga.",
          "background": true
        }
      ]
    ]
  }
}
