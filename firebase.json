{
  "functions": [
    {
      "source": "functions/deploy",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "pnpm --filter @kaden/shared-types build",
        "pnpm --filter @kaden/metrics build",
        "pnpm --filter @kaden/functions build"
      ],
      "ignore": ["node_modules", ".secret.local", "*.local.*", ".env", ".env.*", "**/*.map"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9098 },
    "functions": { "port": 5011 },
    "firestore": { "port": 8088 },
    "storage": { "port": 9198 },
    "ui": { "enabled": true, "port": 4009 }
  }
}
